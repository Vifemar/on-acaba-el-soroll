---
import Layout from "../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const pagina = await getEntry("pagines", "aquest-lloc");

if (!pagina) {
    throw new Error("No s'ha trobat la pàgina 'Aquest lloc'");
}

const { Content } = await render(pagina);
---

<Layout title={`${pagina.data.title} · On acaba el soroll`}>

    <main class="entrada">

        <article class="article-entrada">

            <header class="cap-entrada">

                <p class="categoria">
                    {pagina.data.label}
                </p>

                <h1>
                    {pagina.data.title}
                </h1>

            </header>

            <div class="cos-entrada">
                <Content />
            </div>

        </article>

    </main>

</Layout>