---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

/* Peces creades directament com a arxius sonors */
const pecesSonores = await getCollection("arxiusSonors");

/* Entrades del blog que tenen una versió sonora */
const entrades = await getCollection("entrades");

const entradesSonores = entrades
    .filter((entrada) => entrada.data.audio)
    .map((entrada) => ({
        tipus: "entrada" as const,
        title: entrada.data.title,
        date: entrada.data.date,
        description: entrada.data.description,
        audio: entrada.data.audio!,
        duration: entrada.data.audioDuration,
        url: `/entrades/${entrada.id}/`
    }));

/* Arxius sonors independents */
const arxiusIndependents = pecesSonores.map((arxiu) => ({
    tipus: "arxiu" as const,
    title: arxiu.data.title,
    date: arxiu.data.date,
    description: arxiu.data.description,
    audio: arxiu.data.audio,
    duration: arxiu.data.duration,
    url: arxiu.data.relatedEntry || undefined
}));

/* Unim les dues fonts i les ordenem per data */
const arxius = [
    ...entradesSonores,
    ...arxiusIndependents
].sort((a, b) => b.date.getTime() - a.date.getTime());

const formatData = (data: Date) =>
    data.toLocaleDateString("ca-ES", {
        day: "numeric",
        month: "long",
        year: "numeric"
    });
---

<Layout
    title="Arxius sonors · On acaba el soroll"
    description="Paraules dites en veu alta. Arxius sonors d'On acaba el soroll."
>
    <main class="pagina-sonora">

        <header class="cap-sonora">
            <p class="etiqueta-sonora">ARXIUS SONORS</p>

            <h1>La veu quan les paraules<br />no són només text</h1>

            <p class="introduccio-sonora">
                Hi ha coses que canvien quan són dites en veu alta.
                Aquest és un lloc per guardar-les.
            </p>
        </header>

        <section class="llista-sonora">

            {arxius.length === 0 ? (

                <p class="sense-arxius">
                    Encara no hi ha cap arxiu sonor.
                </p>

            ) : (

                arxius.map((arxiu, index) => (

                    <article class="arxiu-sonor">

                        <div class="numero-sonor">
                            {String(index + 1).padStart(2, "0")}
                        </div>

                        <div class="contingut-sonor">

                            <p class="data-sonora">
                                {formatData(arxiu.date)}
                                {arxiu.duration && (
                                    <> · {arxiu.duration}</>
                                )}
                            </p>

                            <h2>
                                {arxiu.url ? (
                                    <a href={arxiu.url}>
                                        {arxiu.title}
                                    </a>
                                ) : (
                                    arxiu.title
                                )}
                            </h2>

                            <p class="descripcio-sonora">
                                {arxiu.description}
                            </p>

                            <audio controls preload="metadata">
                                <source src={arxiu.audio} />
                                El teu navegador no permet reproduir aquest àudio.
                            </audio>

                            {arxiu.tipus === "entrada" && (
                                <p class="enllac-text">
                                    <a href={arxiu.url}>
                                        Llegir el text →
                                    </a>
                                </p>
                            )}

                        </div>

                    </article>

                ))

            )}

        </section>

    </main>
</Layout>