---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const entrades = (await getCollection("entrades"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const destacada = entrades[0];
const ultimes = entrades.slice(1, 6);

const formatData = (data) =>
    data.toLocaleDateString("ca-ES", {
        day: "numeric",
        month: "long",
        year: "numeric"
    });
---

<Layout title="On acaba el soroll">

    <main class="portada">

        {destacada && (
            <section class="destacada">

                <p class="categoria">
                    {destacada.data.category}
                </p>

                <h2>
                    <a href={`/entrades/${destacada.id}/`}>
                        {destacada.data.title}
                    </a>
                </h2>

                <p class="fragment">
                    {destacada.data.description}
                </p>

                <p class="meta">
                    {formatData(destacada.data.date)}
                </p>

                <a
                    class="llegir"
                    href={`/entrades/${destacada.id}/`}
                >
                    Llegir →
                </a>

            </section>
        )}


        {ultimes.length > 0 && (
            <section class="ultims">

                <p class="seccio-titol">
                    ÚLTIMS TEXTOS
                </p>

                {ultimes.map((entrada) => (

                    <article class="resum">

                        <div class="data">
                            {formatData(entrada.data.date)}
                        </div>

                        <div class="contingut-resum">

                            <p class="categoria">
                                {entrada.data.category}
                            </p>

                            <h3>
                                <a href={`/entrades/${entrada.id}/`}>
                                    {entrada.data.title}
                                </a>
                            </h3>

                            <p>
                                {entrada.data.description}
                            </p>

                        </div>

                    </article>

                ))}

            </section>
        )}

    </main>

</Layout>
<script>
    import { handleAuthCallback } from "@netlify/identity";

    async function processarIdentity() {
        const hash = window.location.hash;

        if (
            !hash.includes("recovery_token") &&
            !hash.includes("invite_token") &&
            !hash.includes("confirmation_token")
        ) {
            return;
        }

        try {
            const resultat = await handleAuthCallback();

            console.log("Identity callback:", resultat);

            if (resultat) {
                document.body.insertAdjacentHTML(
                    "afterbegin",
                    `
                    <div id="identity-missatge" style="
                        position: fixed;
                        top: 20px;
                        left: 50%;
                        transform: translateX(-50%);
                        z-index: 99999;
                        background: #f4f0e8;
                        border: 1px solid #cfc8bc;
                        padding: 18px 25px;
                        font-family: Georgia, serif;
                        box-shadow: 0 4px 20px rgba(0,0,0,.12);
                    ">
                        Accés verificat correctament.
                    </div>
                    `
                );
            }

        } catch (error) {
            console.error("Error Identity:", error);

            document.body.insertAdjacentHTML(
                "afterbegin",
                `
                <div style="
                    position: fixed;
                    top: 20px;
                    left: 50%;
                    transform: translateX(-50%);
                    z-index: 99999;
                    background: #f4f0e8;
                    border: 1px solid #cfc8bc;
                    padding: 18px 25px;
                    font-family: Georgia, serif;
                ">
                    No s'ha pogut processar l'enllaç d'accés.
                </div>
                `
            );
        }
    }

    processarIdentity();
</script>