---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const entrades = (await getCollection("entrades"))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const destacada = entrades[0];
const ultimes = entrades.slice(1, 6);

const formatData = (data) =>
    data.toLocaleDateString("ca-ES", {
        day: "numeric",
        month: "long",
        year: "numeric"
    });
---

<Layout title="On acaba el soroll">

    <main class="portada">

        {destacada && (
            <section class="destacada">

                <p class="categoria">
                    {destacada.data.category}
                </p>

                <h2>
                    <a href={`/entrades/${destacada.id}/`}>
                        {destacada.data.title}
                    </a>
                </h2>

                <p class="fragment">
                    {destacada.data.description}
                </p>

                <p class="meta">
                    {formatData(destacada.data.date)}
                </p>

                <a
                    class="llegir"
                    href={`/entrades/${destacada.id}/`}
                >
                    Llegir →
                </a>

            </section>
        )}


        {ultimes.length > 0 && (
            <section class="ultims">

                <p class="seccio-titol">
                    ÚLTIMS TEXTOS
                </p>

                {ultimes.map((entrada) => (

                    <article class="resum">

                        <div class="data">
                            {formatData(entrada.data.date)}
                        </div>

                        <div class="contingut-resum">

                            <p class="categoria">
                                {entrada.data.category}
                            </p>

                            <h3>
                                <a href={`/entrades/${entrada.id}/`}>
                                    {entrada.data.title}
                                </a>
                            </h3>

                            <p>
                                {entrada.data.description}
                            </p>

                        </div>

                    </article>

                ))}

            </section>
        )}

    </main>

</Layout>


<script>
    import {
        handleAuthCallback,
        acceptInvite,
        updateUser
    } from "@netlify/identity";


    async function processarIdentity() {

        const hash = window.location.hash;

        const esInvite =
            hash.includes("invite_token");

        const esRecovery =
            hash.includes("recovery_token");


        /*
         * Si hem entrat normalment a la portada,
         * no fem absolutament res.
         */
        if (!esInvite && !esRecovery) {
            return;
        }


        try {

            /*
             * Netlify processa el token que hi ha
             * en l'URL.
             */
            const resultat =
                await handleAuthCallback();


            console.log(
                "Resultat Identity:",
                resultat
            );


            if (!resultat) {
                throw new Error(
                    "Netlify no ha retornat cap resultat."
                );
            }


            const tipus = resultat.type;

            /*
             * En una invitació necessitarem
             * aquest token per a acceptInvite().
             */
            const inviteToken =
                resultat.token || null;


            if (
                tipus !== "invite" &&
                tipus !== "recovery"
            ) {
                return;
            }


            /*
             * Mostrem el formulari.
             */
            document.body.insertAdjacentHTML(
                "afterbegin",
                `
                <div
                    id="recuperacio-password"
                    style="
                        position: fixed;
                        inset: 0;
                        z-index: 99999;

                        display: flex;
                        align-items: center;
                        justify-content: center;

                        padding: 20px;

                        background:
                            rgba(20,20,20,.55);
                    "
                >

                    <div
                        style="
                            width: min(420px, 100%);

                            box-sizing: border-box;

                            background: #f4f0e8;

                            border:
                                1px solid #cfc8bc;

                            padding: 35px;

                            font-family:
                                Georgia, serif;

                            color: #222;

                            box-shadow:
                                0 8px 35px
                                rgba(0,0,0,.25);
                        "
                    >

                        <h2
                            style="
                                margin:
                                    0 0 10px;

                                font-weight: 400;
                            "
                        >
                            Nova contrasenya
                        </h2>


                        <p
                            id="missatge-password"
                            style="
                                margin-bottom:
                                    25px;

                                color: #666;

                                line-height: 1.5;
                            "
                        >
                            Escriu la contrasenya que utilitzaràs per entrar al panell.
                        </p>


                        <label
                            for="nova-password"
                            style="
                                display: block;
                                margin-bottom: 6px;
                            "
                        >
                            Contrasenya
                        </label>


                        <input
                            id="nova-password"
                            type="password"
                            autocomplete="new-password"

                            style="
                                box-sizing:
                                    border-box;

                                width: 100%;

                                padding: 12px;

                                margin-bottom:
                                    18px;

                                border:
                                    1px solid #bbb;

                                background: #fff;

                                font-size: 1rem;
                            "
                        />


                        <label
                            for="repetir-password"
                            style="
                                display: block;
                                margin-bottom: 6px;
                            "
                        >
                            Repetix la contrasenya
                        </label>


                        <input
                            id="repetir-password"
                            type="password"
                            autocomplete="new-password"

                            style="
                                box-sizing:
                                    border-box;

                                width: 100%;

                                padding: 12px;

                                margin-bottom:
                                    22px;

                                border:
                                    1px solid #bbb;

                                background: #fff;

                                font-size: 1rem;
                            "
                        />


                        <button
                            id="guardar-password"
                            type="button"

                            style="
                                width: 100%;

                                padding:
                                    12px 18px;

                                border: 0;

                                background: #222;

                                color: #fff;

                                cursor: pointer;

                                font-size: .9rem;
                            "
                        >
                            Guardar contrasenya
                        </button>

                    </div>

                </div>
                `
            );


            const boto =
                document.getElementById(
                    "guardar-password"
                );

            const missatge =
                document.getElementById(
                    "missatge-password"
                );

            const campPassword =
                document.getElementById(
                    "nova-password"
                );

            const campRepetir =
                document.getElementById(
                    "repetir-password"
                );


            boto?.addEventListener(
                "click",
                async () => {

                    const password =
                        campPassword?.value || "";

                    const repetir =
                        campRepetir?.value || "";


                    if (password.length < 8) {

                        missatge.textContent =
                            "La contrasenya ha de tindre almenys 8 caràcters.";

                        return;
                    }


                    if (password !== repetir) {

                        missatge.textContent =
                            "Les dues contrasenyes no coincidixen.";

                        return;
                    }


                    boto.disabled = true;
                    boto.textContent =
                        "Guardant...";


                    try {

                        /*
                         * CAS 1:
                         * és un usuari nou convidat.
                         */
                        if (tipus === "invite") {

                            if (!inviteToken) {
                                throw new Error(
                                    "No s'ha pogut recuperar el token de la invitació."
                                );
                            }

                            await acceptInvite(
                                inviteToken,
                                password
                            );

                        }


                        /*
                         * CAS 2:
                         * és un usuari existent
                         * recuperant la contrasenya.
                         */
                        else if (
                            tipus === "recovery"
                        ) {

                            await updateUser({
                                password
                            });

                        }


                        missatge.textContent =
                            "Contrasenya guardada correctament. Entrant al panell...";


                        /*
                         * Eliminem el token de la URL.
                         */
                        window.history.replaceState(
                            {},
                            document.title,
                            window.location.pathname
                        );


                        /*
                         * Donem un moment perquè Identity
                         * guarde la sessió.
                         */
                        setTimeout(() => {

                            window.location.href =
                                "/admin/";

                        }, 1200);


                    } catch (error) {

                        console.error(
                            "ERROR GUARDANT PASSWORD:",
                            error
                        );


                        /*
                         * IMPORTANT:
                         * ara mostrarem l'error REAL
                         * de Netlify, no un missatge genèric.
                         */
                        const detall =
                            error?.message ||
                            String(error);


                        missatge.textContent =
                            "Error: " + detall;


                        boto.disabled = false;

                        boto.textContent =
                            "Guardar contrasenya";

                    }

                }
            );


        } catch (error) {

            console.error(
                "ERROR PROCESSANT IDENTITY:",
                error
            );

        }

    }


    processarIdentity();
</script>